@model InTakeWise.ViewModels.MealSuggestionViewModel
@using InTakeWise.Helper

@{
    ViewData["Title"] = "Today Meal Plan";
    var hasPlan = Model.Plan != null;
    var selected = Model.SelectedMealSuggestion;
}

<div class="auth-page">
    <div class="auth-card menu-card">

        <section class="auth-main">
            <div class="menu-actions">
                <h1 class="auth-title">@ViewData["Title"]</h1>

                @if (!hasPlan)
                {
                    <div class="menu-action shopping-empty-state">
                        <div class="menu-action-sub">No @Model.SelectedMeal.ToDisplayName() plan saved for today.</div>
                        <div class="menu-action-sub">
                            Generate your weekly shopping plan first, then today’s meals will appear here.
                        </div>
                    </div>
                }
                else
                {
                    <section class="menu-action shopping-results-card">
                        <div class="shopping-card-header">
                            <h3 class="shopping-card-title">
                                @Model.Plan!.Day @(Model.Plan.IsGymDay ? "(Gym Day)" : "")
                            </h3>
                            <span class="status-badge status-logged">Today</span>
                        </div>

                        <div class="shopping-macro-grid">
                            <div class="shopping-macro-box">
                                <span class="shopping-macro-label">Calories</span>
                                <strong class="shopping-macro-value">@Model.Plan.Calories</strong>
                            </div>
                            <div class="shopping-macro-box">
                                <span class="shopping-macro-label">Protein</span>
                                <strong class="shopping-macro-value">@Model.Plan.ProteinGrams g</strong>
                            </div>
                            <div class="shopping-macro-box">
                                <span class="shopping-macro-label">Carbs</span>
                                <strong class="shopping-macro-value">@Model.Plan.CarbsGrams g</strong>
                            </div>
                            <div class="shopping-macro-box">
                                <span class="shopping-macro-label">Fat</span>
                                <strong class="shopping-macro-value">@Model.Plan.FatGrams g</strong>
                            </div>
                        </div>
                    </section>

                    <div class="menu-actions-row meal-plan-grid">
                        <a class="menu-action menu-meal-row" asp-action="Index" asp-route-meal="@MealType.Breakfast">
                            <div class="menu-action-title">Breakfast</div>
                            <div class="menu-action-sub">
                                <span class="status-badge @(Model.SelectedMeal == MealType.Breakfast ? "status-logged" : "status-pending")">
                                    @(Model.SelectedMeal == MealType.Breakfast ? "Selected" : "View")
                                </span>
                            </div>
                        </a>

                        <a class="menu-action menu-meal-row" asp-action="Index" asp-route-meal="@MealType.Dinner">
                            <div class="menu-action-title">Dinner</div>
                            <div class="menu-action-sub">
                                <span class="status-badge @(Model.SelectedMeal == MealType.Dinner ? "status-logged" : "status-pending")">
                                    @(Model.SelectedMeal == MealType.Dinner ? "Selected" : "View")
                                </span>
                            </div>
                        </a>

                        <a class="menu-action menu-meal-row" asp-action="Index" asp-route-meal="@MealType.Tea">
                            <div class="menu-action-title">Tea</div>
                            <div class="menu-action-sub">
                                <span class="status-badge @(Model.SelectedMeal == MealType.Tea ? "status-logged" : "status-pending")">
                                    @(Model.SelectedMeal == MealType.Tea ? "Selected" : "View")
                                </span>
                            </div>
                        </a>

                        <a class="menu-action menu-meal-row" asp-action="Index" asp-route-meal="@MealType.Snack">
                            <div class="menu-action-title">Snack</div>
                            <div class="menu-action-sub">
                                <span class="status-badge @(Model.SelectedMeal == MealType.Snack ? "status-logged" : "status-pending")">
                                    @(Model.SelectedMeal == MealType.Snack ? "Selected" : "View")
                                </span>
                            </div>
                        </a>
                    </div>

                    <section class="menu-action shopping-results-card">
                        @if (selected is null)
                        {
                            <div class="menu-action-sub">No @Model.SelectedMeal plan saved for today.</div>
                        }
                        else
                        {
                            @if (!string.IsNullOrWhiteSpace(selected.Description))
                            {
                                <div class="shopping-snack-section">
                                    <div class="shopping-snack-title">Overview</div>

                                    <div class="shopping-meal-lines">
                                        @foreach (var line in selected.Description.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                        {
                                            <div class="shopping-meal-line">@line</div>
                                        }
                                    </div>
                                </div>
                            }

                            @if (selected.IngredientsUsed.Any())
                            {
                                <div class="shopping-snack-section">
                                    <div class="shopping-snack-title">Ingredients</div>

                                    <ul class="shopping-ingredient-list">
                                        @foreach (var ingredient in selected.IngredientsUsed)
                                        {
                                            <li class="shopping-ingredient-item">@ingredient</li>
                                        }
                                    </ul>
                                </div>
                            }

                            @if (selected.Steps.Any())
                            {
                                <div class="shopping-snack-section">
                                    <div class="shopping-snack-title">Steps</div>

                                    <ol class="shopping-step-list">
                                        @foreach (var step in selected.Steps)
                                        {
                                            <li class="shopping-step-item">@step</li>
                                        }
                                    </ol>
                                </div>
                            }
                        }
                    </section>
                }
            </div>
        </section>

        @await Component.InvokeAsync("MenuSide", new { variant = "compact" })
        @await Component.InvokeAsync("FloatingBackButton", new { text = "BACK", fallbackUrl = Url.Action("Index", "Home") })
    </div>
</div>
