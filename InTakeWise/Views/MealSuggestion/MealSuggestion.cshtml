@model InTakeWise.ViewModels.MealSuggestionViewModel

@{
    ViewData["Title"] = "Today Meal Plan";
}

<div class="auth-page">
    <div class="auth-card menu-card">

        <!-- MAIN -->
        <section class="auth-main">
            <div class="menu-actions">
                <h1 class="auth-title">@ViewData["Title"]</h1>

                <a class="menu-action" asp-controller="Pantry" asp-action="Index">
                    <div class="menu-action-title">Whats in my fridge ?</div>
                    <div class="menu-action-sub">Check whats in your fridge before generating</div>
                </a>

                <form asp-controller="MealSuggestion"
                      asp-action="Regenerate"
                      method="post"
                      class="log-form">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-primary">
                        Regenerate meals
                    </button>

                </form>
                <div class="menu-actions-row">
                    <a class="menu-action menu-meal-row" asp-action="Index" asp-route-meal="Breakfast">
                        <div class="menu-action-title">Breakfast</div>
                        <div class="menu-action-sub">
                            <span class="status-badge @(Model.SelectedMeal == "Breakfast" ? "status-logged" : "status-pending")">
                                @(Model.SelectedMeal == "Breakfast" ? "Selected" : "View")
                            </span>
                        </div>
                    </a>

                    <a class="menu-action menu-meal-row" asp-action="Index" asp-route-meal="Dinner">
                        <div class="menu-action-title">Dinner</div>
                        <div class="menu-action-sub">
                            <span class="status-badge @(Model.SelectedMeal == "Dinner" ? "status-logged" : "status-pending")">
                                @(Model.SelectedMeal == "Dinner" ? "Selected" : "View")
                            </span>
                        </div>
                    </a>

                    <a class="menu-action menu-meal-row" asp-action="Index" asp-route-meal="Tea">
                        <div class="menu-action-title">Tea</div>
                        <div class="menu-action-sub">
                            <span class="status-badge @(Model.SelectedMeal == "Tea" ? "status-logged" : "status-pending")">
                                @(Model.SelectedMeal == "Tea" ? "Selected" : "View")
                            </span>
                        </div>
                    </a>
                </div>               

                <h1 class="auth-title">@Model.SelectedMeal Plan</h1>

                @if (Model.SelectedMealSuggestion is null)
                {
                    <text>No suggestion yet.</text>
                }
                else
                {
                    var m = Model.SelectedMealSuggestion;

                    <text>@m.Title</text>
                    <text>

                        @m.Description

                        Calories: @m.Calories | P: @m.ProteinGrams g | C: @m.CarbsGrams g | F: @m.FatGrams g

                        Ingredients:
                        - @string.Join("\n- ", m.IngredientsUsed)

                        Steps:
                        - @string.Join("\n- ", m.Steps)
                    </text>
                }

            </div>
        </section>

        <!-- SIDE -->
        @await Component.InvokeAsync("MenuSide", new { variant = "compact" })

    </div>
</div>

@await Component.InvokeAsync("FloatingBackButton", new { controller = "Home", action = "Index", text = "BACK" })
