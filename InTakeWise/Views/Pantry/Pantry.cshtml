@model HomeViewModel

@{
    var isMeal = Model.Mode == LogType.LoggingType.Meal;
    ViewData["Title"] = "Whats in your Pantry";
}

<div class="auth-page">
    <div class="auth-card menu-card">

        <!-- MAIN -->
        <section class="auth-main"> 
            <div class="menu-actions">
                <h1 class="auth-title">@ViewData["Title"]</h1>

                <form asp-controller="Pantry"
                      asp-action="SavePantryInfo"
                      method="post"
                      class="log-form">
                    <input type="hidden" name="Mode" value="@Model.Mode" />

                    <textarea name="userInput"
                              class="log-text-box menu-action"
                              rows="6">
                    @foreach (var item in Model.ItemsInPantry.ItemsAtHome)
                    {
                        @($"{item.Name} - {item.Quantity} {item.Unit}\n")
                    }
                    </textarea>

                    <button type="submit" class="btn-primary">
                        Save
                    </button>

                </form>

            </div>
        </section>

        <!-- SIDE -->
        <aside class="auth-side menu-side menu-minimised">
            <div class="side-top">
                <h2 class="auth-side-title">@Model.UserName</h2>
                <div class="menu-side-box curved">2000 / 2200</div>
            </div>

            <p class="auth-side-subtitle">
                Protein 120/220 • Carb 200/210 • Fat 24/30 • Fiber 13/40
            </p>
        </aside>

    </div>
</div>
