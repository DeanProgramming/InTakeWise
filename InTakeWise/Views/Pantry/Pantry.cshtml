@model InTakeWise.ViewModels.PantryViewModel

@{
    ViewData["Title"] = "Whats in your Pantry";
}

<div class="auth-page">
    <div class="auth-card menu-card">

        <!-- MAIN -->
        <section class="auth-main">
            <div class="menu-actions">
                <h1 class="auth-title">@ViewData["Title"]</h1>

                <form asp-controller="Pantry"
                      asp-action="SavePantryInfo"
                      method="post"
                      class="log-form">
                    @Html.AntiForgeryToken()

                    <textarea name="userInput"
                              class="log-text-box menu-action"
                              rows="10"
                              style="white-space: pre-wrap;">
                    @foreach (var item in Model.Items)
                    {
                        var name = item.FoodItem?.Name ?? "(unknown item)";
                        var expiry = item.ExpiryDate.HasValue ? $" (Expires: {item.ExpiryDate:yyyy-MM-dd})" : "";
                        @($"{name} - {item.Quantity} {item.Unit}{expiry}\n")
                    }
                    
                </textarea>

                    <button type="submit" class="btn-primary">
                        Save
                    </button>
                </form>

            </div>
        </section>

        <!-- SIDE -->
        @await Component.InvokeAsync("MenuSide", new { variant = "compact" })

    </div>
</div>
