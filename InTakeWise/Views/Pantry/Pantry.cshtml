@model InTakeWise.ViewModels.PantryViewModel

@{
    ViewData["Title"] = "Whats in your Pantry";
     
    var text = string.Join(Environment.NewLine,
        (Model.Items ?? Enumerable.Empty<InTakeWise.Models.PantryItem>())
        .Select(item =>
        {
            var name = item.FoodItem?.Name ?? "(unknown item)";
            var expiry = item.ExpiryDate.HasValue
                ? $" (Expires: {item.ExpiryDate.Value:yyyy-MM-dd})"
                : "";
            return $"{name} - {item.Quantity} {item.Unit}{expiry}";
        })
    );
}

<div class="auth-page">
    <div class="auth-card menu-card">

        <!-- MAIN -->
        <section class="auth-main">
            <div class="menu-actions"> 

                <a class="menu-action"
                   asp-controller="Receipt"
                   asp-action="Index"
                   asp-route-redirect="Pantry">
                    <div class="menu-action-title">Receipt to Pantry</div>
                    <div class="menu-action-sub">Take a photo of the Receipt</div>
                </a>

                <h1 class="auth-title">@ViewData["Title"]</h1>

                 
                @if (TempData["PantrySaved"] is string msg)
                {
                    <div class="menu-action">@msg</div>
                }

                <form asp-controller="Pantry"
                      asp-action="SavePantryInfo"
                      method="post"
                      class="log-form">
                    @Html.AntiForgeryToken()

                    <textarea name="userInput"
                              class="log-text-box menu-action"
                              rows="10"
                              style="white-space: pre-wrap;">@text</textarea>

                    <button type="submit" class="btn-primary">
                        Save
                    </button>
                </form>

            </div>
        </section>

        <!-- SIDE -->
        @await Component.InvokeAsync("MenuSide", new { variant = "compact" })

    </div>
</div>

@await Component.InvokeAsync("FloatingBackButton", new {text = "BACK", fallbackUrl = Url.Action("Index", "Home")})
