@using InTakeWise.Helper
@using InTakeWise.Data
@model InTakeWise.ViewModels.LogEntryViewModel

@{
    var isMeal = Model.Mode == LogType.LoggingType.Meal;
    ViewData["Title"] = isMeal ? "Log Meal" : "Log Workout";
    var isDemo = User.HasClaim(DbSeeder.DemoClaimType, DbSeeder.DemoClaimValue);
}

<div class="auth-page">
    <div class="auth-card menu-card">

        <section class="auth-main">
            <div class="menu-actions">
                <h1 class="auth-title">@ViewData["Title"]</h1>

                <div class="menu-action log-intro-card">
                    @if (isDemo)
                    {

                        <div class="menu-action log-intro-card">
                            <div class="menu-action-title">
                                @(isMeal ? "View sample meal analysis" : "View sample workout analysis")
                            </div>
                        </div>

                        <div class="menu-action-sub">
                            This is pre-generated sample data.
                            Live AI analysis is disabled in demo mode.
                        </div>
                    }
                    else
                    {
                        <div class="menu-action-title">
                            @(isMeal ? "Tell us what you ate" : "Tell us what workout you did")
                        </div>
                        <div class="menu-action-sub">
                            @(isMeal ? "You can write naturally, for example: 2 eggs, 2 slices of toast, 1 banana, black coffee." : "You can write naturally, for example: 45 min incline treadmill and 20 min weights.")
                        </div>
                    }
                </div>

                @if (isMeal)
                {
                    <div class="menu-actions-row log-meal-tabs">
                        <a class="menu-action menu-meal-row @(Model.SelectedTimeOfDay == MealType.Breakfast ? "is-selected-tile" : "")"
                           asp-action="Index"
                           asp-route-mode="@Model.Mode"
                           asp-route-meal="@MealType.Breakfast">
                            <div class="menu-action-title">Breakfast</div>
                            <div class="menu-action-sub">
                                <span class="status-badge @(Model.SelectedTimeOfDay == MealType.Breakfast ? "status-logged" : "status-pending")">
                                    @(Model.SelectedTimeOfDay == MealType.Breakfast ? "Selected" : "View")
                                </span>
                            </div>
                        </a>

                        <a class="menu-action menu-meal-row @(Model.SelectedTimeOfDay == MealType.Dinner ? "is-selected-tile" : "")"
                           asp-action="Index"
                           asp-route-mode="@Model.Mode"
                           asp-route-meal="@MealType.Dinner">
                            <div class="menu-action-title">Dinner</div>
                            <div class="menu-action-sub">
                                <span class="status-badge @(Model.SelectedTimeOfDay == MealType.Dinner ? "status-logged" : "status-pending")">
                                    @(Model.SelectedTimeOfDay == MealType.Dinner ? "Selected" : "View")
                                </span>
                            </div>
                        </a>

                        <a class="menu-action menu-meal-row @(Model.SelectedTimeOfDay == MealType.Tea ? "is-selected-tile" : "")"
                           asp-action="Index"
                           asp-route-mode="@Model.Mode"
                           asp-route-meal="@MealType.Tea">
                            <div class="menu-action-title">Tea</div>
                            <div class="menu-action-sub">
                                <span class="status-badge @(Model.SelectedTimeOfDay == MealType.Tea ? "status-logged" : "status-pending")">
                                    @(Model.SelectedTimeOfDay == MealType.Tea ? "Selected" : "View")
                                </span>
                            </div>
                        </a>

                        <a class="menu-action menu-meal-row @(Model.SelectedTimeOfDay == MealType.Snack ? "is-selected-tile" : "")"
                           asp-action="Index"
                           asp-route-mode="@Model.Mode"
                           asp-route-meal="@MealType.Snack">
                            <div class="menu-action-title">Snack</div>
                            <div class="menu-action-sub">
                                <span class="status-badge @(Model.SelectedTimeOfDay == MealType.Snack ? "status-logged" : "status-pending")">
                                    @(Model.SelectedTimeOfDay == MealType.Snack ? "Selected" : "View")
                                </span>
                            </div>
                        </a>
                    </div>
                }

                @if (User.HasClaim(DbSeeder.DemoClaimType, DbSeeder.DemoClaimValue))
                {
                    <div class="menu-action log-intro-card">
                        <div class="menu-action-title">Sample analysis</div>
                        <div class="menu-action-sub">
                            Live AI analysis is disabled in demo mode.
                            The result below contains pre-generated sample data.
                        </div>
                    </div>
                }
                else
                {
                    @if (!string.IsNullOrWhiteSpace(Model.Error))
                    {
                        <div class="menu-action log-intro-card" role="alert">
                            <div class="menu-action-title">Could not generate analysis</div>
                            <div class="menu-action-sub">@Model.Error</div>
                        </div>
                    }

                    <form asp-controller="LogEntry"
                          asp-action="@(isMeal ? "Meal" : "Workout")"
                          method="post"
                          class="log-form">
                        @Html.AntiForgeryToken()

                        <input type="hidden" name="mode" value="@Model.Mode" />

                        @if (isMeal)
                        {
                            <input type="hidden" name="logTime" value="@Model.SelectedTimeOfDay" />
                        }

                        <label class="log-section-label">
                            @(isMeal ? $"{Model.SelectedTimeOfDay} entry" : "Workout entry")
                        </label>

                        <textarea name="userInput"
                              class="log-text-box menu-action"
                              rows="5"
                              maxlength="@InTakeWise.Services.AiInputValidator.MaximumLogInputCharacters"
                              required
                              aria-describedby="log-input-help"
                              placeholder="@(isMeal ? "Example: 200g chicken, rice, broccoli, yogurt..." : "Example: 30 min run, 20 min weights, moderate intensity...")">@Model.UserInput</textarea>

                        <div id="log-input-help" class="menu-action-sub">
                            Maximum @InTakeWise.Services.AiInputValidator.MaximumLogInputCharacters.ToString("N0") characters.
                        </div>

                        <button type="submit" class="menu-action menu-primary-btn log-submit-btn">
                            <span class="menu-action-title">Generate</span>
                            <span class="menu-action-sub">
                                @(isMeal ? "Estimate calories and macros" : "Estimate workout burn")
                            </span>
                        </button>
                    </form>
                }

                @if (isMeal && Model.GeneratedMealLog != null)
                {
                    <div class="menu-action log-result-card">
                        <div class="log-card-header">
                            <h3 class="log-card-title">Meal Result</h3>
                            <span class="status-badge status-logged">@Model.SelectedTimeOfDay</span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.GeneratedMealLog.RawInput))
                        {
                            <div class="log-raw-input">
                                @Model.GeneratedMealLog.RawInput
                            </div>
                        }

                        <div class="shopping-macro-grid log-macro-grid">
                            <div class="shopping-macro-box">
                                <span class="shopping-macro-label">Calories</span>
                                <span class="shopping-macro-value">@Model.GeneratedMealLog.Calories</span>
                            </div>

                            <div class="shopping-macro-box">
                                <span class="shopping-macro-label">Protein</span>
                                <span class="shopping-macro-value">@Model.GeneratedMealLog.Protein g</span>
                            </div>

                            <div class="shopping-macro-box">
                                <span class="shopping-macro-label">Carbs</span>
                                <span class="shopping-macro-value">@Model.GeneratedMealLog.Carbs g</span>
                            </div>

                            <div class="shopping-macro-box">
                                <span class="shopping-macro-label">Fat</span>
                                <span class="shopping-macro-value">@Model.GeneratedMealLog.Fat g</span>
                            </div>

                            <div class="shopping-macro-box log-wide-box">
                                <span class="shopping-macro-label">Fiber</span>
                                <span class="shopping-macro-value">@Model.GeneratedMealLog.Fiber g</span>
                            </div>
                        </div>
                    </div>
                }
                else if (!isMeal && Model.GeneratedWorkoutLog != null)
                {
                    <div class="menu-action log-result-card">
                        <div class="log-card-header">
                            <h3 class="log-card-title">Workout Result</h3>
                            <span class="status-badge status-logged">Logged</span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.GeneratedWorkoutLog.RawInput))
                        {
                            <div class="log-raw-input">
                                @Model.GeneratedWorkoutLog.RawInput
                            </div>
                        }

                        <div class="shopping-macro-grid log-macro-grid">
                            <div class="shopping-macro-box">
                                <span class="shopping-macro-label">Activity</span>
                                <span class="shopping-macro-value">@(Model.GeneratedWorkoutLog.ActivityType ?? "Unknown")</span>
                            </div>

                            <div class="shopping-macro-box">
                                <span class="shopping-macro-label">Duration</span>
                                <span class="shopping-macro-value">@(Model.GeneratedWorkoutLog.DurationMinutes?.ToString() ?? "0") min</span>
                            </div>

                            <div class="shopping-macro-box">
                                <span class="shopping-macro-label">Intensity</span>
                                <span class="shopping-macro-value">@(Model.GeneratedWorkoutLog.Intensity ?? "Unknown")</span>
                            </div>

                            <div class="shopping-macro-box">
                                <span class="shopping-macro-label">Calories Burned</span>
                                <span class="shopping-macro-value">@Model.GeneratedWorkoutLog.CaloriesBurned</span>
                            </div>
                        </div>
                    </div>
                }

                @if (Model.DailySummary != null)
                {
                    <div class="menu-action log-result-card">
                        <div class="log-card-header">
                            <h3 class="log-card-title">Today Summary</h3>
                            <span class="status-badge @(Model.DailySummary.IsGymDay ? "status-logged" : "status-pending")">
                                @(Model.DailySummary.IsGymDay ? "Gym Day" : "Non-Gym Day")
                            </span>
                        </div>

                        <div class="log-summary-grid">
                            <div class="log-summary-block">
                                <div class="log-summary-heading">Targets</div>
                                <div class="log-summary-row">
                                    <span>Calories</span>
                                    <strong>@Model.DailySummary.CaloriesTarget</strong>
                                </div>
                                <div class="log-summary-row">
                                    <span>Protein</span>
                                    <strong>@Model.DailySummary.ProteinTarget g</strong>
                                </div>
                                <div class="log-summary-row">
                                    <span>Carbs</span>
                                    <strong>@Model.DailySummary.CarbsTarget g</strong>
                                </div>
                                <div class="log-summary-row">
                                    <span>Fat</span>
                                    <strong>@Model.DailySummary.FatTarget g</strong>
                                </div>
                                <div class="log-summary-row">
                                    <span>Fiber</span>
                                    <strong>@Model.DailySummary.FiberTarget g</strong>
                                </div>
                            </div>

                            <div class="log-summary-block">
                                <div class="log-summary-heading">Consumed</div>
                                <div class="log-summary-row">
                                    <span>Calories</span>
                                    <strong>@Model.DailySummary.CaloriesEaten</strong>
                                </div>
                                <div class="log-summary-row">
                                    <span>Protein</span>
                                    <strong>@Model.DailySummary.ProteinEaten g</strong>
                                </div>
                                <div class="log-summary-row">
                                    <span>Carbs</span>
                                    <strong>@Model.DailySummary.CarbsEaten g</strong>
                                </div>
                                <div class="log-summary-row">
                                    <span>Fat</span>
                                    <strong>@Model.DailySummary.FatEaten g</strong>
                                </div>
                                <div class="log-summary-row">
                                    <span>Fiber</span>
                                    <strong>@Model.DailySummary.FiberEaten g</strong>
                                </div>
                            </div>

                            <div class="log-summary-block">
                                <div class="log-summary-heading">Remaining</div>
                                <div class="log-summary-row">
                                    <span>Calories</span>
                                    <strong>@Model.DailySummary.RemainingCalories</strong>
                                </div>
                                <div class="log-summary-row">
                                    <span>Protein</span>
                                    <strong>@Model.DailySummary.RemainingProtein g</strong>
                                </div>
                                <div class="log-summary-row">
                                    <span>Carbs</span>
                                    <strong>@Model.DailySummary.RemainingCarbs g</strong>
                                </div>
                                <div class="log-summary-row">
                                    <span>Fat</span>
                                    <strong>@Model.DailySummary.RemainingFat g</strong>
                                </div>
                                <div class="log-summary-row">
                                    <span>Fiber</span>
                                    <strong>@Model.DailySummary.RemainingFiber g</strong>
                                </div>
                            </div>

                            <div class="log-summary-block">
                                <div class="log-summary-heading">Workout</div>
                                <div class="log-summary-row">
                                    <span>Calories Burned</span>
                                    <strong>@Model.DailySummary.CaloriesBurned</strong>
                                </div>
                                <div class="log-summary-row">
                                    <span>Net Calories</span>
                                    <strong>@Model.DailySummary.NetCalories</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>

        @await Component.InvokeAsync("MenuSide", new { variant = "compact" })

        @await Component.InvokeAsync("FloatingBackButton", new { text = "BACK", fallbackUrl = Url.Action("Index", "Home") })
    </div>
</div>


@section Scripts {
    <script>
        (() => {
            const mode = '@Model.Mode';
            const isMeal = '@(isMeal ? "true" : "false")' === "true";
            const tod = isMeal ? '@Model.SelectedTimeOfDay' : 'Workout';
            const key = `InTakeWise.LogDraft.${mode}.${tod}`;

            const form = document.querySelector('.log-form');
            const ta = document.querySelector('textarea[name="userInput"]');
            if (!ta) return;

            const draft = localStorage.getItem(key);
            if (draft !== null && !ta.value) ta.value = draft;

            ta.addEventListener('input', () => localStorage.setItem(key, ta.value));

            form?.addEventListener('submit', () => localStorage.removeItem(key));


        })();
    </script>
}
