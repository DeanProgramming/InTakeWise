@model InTakeWise.ViewModels.LogEntryViewModel

@{
    var isMeal = Model.Mode == LogType.LoggingType.Meal;
    ViewData["Title"] = isMeal ? "Log Meal" : "Log Workout";
}

<div class="auth-page">
    <div class="auth-card menu-card">

        <!-- MAIN -->
        <section class="auth-main">
            <div class="menu-actions">
                <h1 class="auth-title">@ViewData["Title"]</h1>
                 
                @if (isMeal)
                {
                    <div class="menu-actions-row">
                        <a class="menu-action menu-meal-row"
                           asp-action="Index"
                           asp-route-mode="@Model.Mode"
                           asp-route-meal="@TimeOfDay.Breakfast">
                            <div class="menu-action-title">Breakfast</div>
                            <div class="menu-action-sub">
                                <span class="status-badge @(Model.SelectedTimeOfDay == TimeOfDay.Breakfast ? "status-logged" : "status-pending")">
                                    @(Model.SelectedTimeOfDay == TimeOfDay.Breakfast ? "Selected" : "View")
                                </span>
                            </div>
                        </a>

                        <a class="menu-action menu-meal-row"
                           asp-action="Index"
                           asp-route-mode="@Model.Mode"
                           asp-route-meal="@TimeOfDay.Dinner">
                            <div class="menu-action-title">Dinner</div>
                            <div class="menu-action-sub">
                                <span class="status-badge @(Model.SelectedTimeOfDay == TimeOfDay.Dinner ? "status-logged" : "status-pending")">
                                    @(Model.SelectedTimeOfDay == TimeOfDay.Dinner ? "Selected" : "View")
                                </span>
                            </div>
                        </a>

                        <a class="menu-action menu-meal-row"
                           asp-action="Index"
                           asp-route-mode="@Model.Mode"
                           asp-route-meal="@TimeOfDay.Tea">
                            <div class="menu-action-title">Tea</div>
                            <div class="menu-action-sub">
                                <span class="status-badge @(Model.SelectedTimeOfDay == TimeOfDay.Tea ? "status-logged" : "status-pending")">
                                    @(Model.SelectedTimeOfDay == TimeOfDay.Tea ? "Selected" : "View")
                                </span>
                            </div>
                        </a>
                    </div>
                }

                <form asp-controller="LogEntry"
                      asp-action="@(isMeal ? "Meal" : "Workout")"
                      method="post"
                      class="log-form">
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="mode" value="@Model.Mode" />
                     
                    @if (isMeal)
                    {
                        <input type="hidden" name="logTime" value="@Model.SelectedTimeOfDay" />
                    }

                    <textarea name="userInput"
                              class="log-text-box menu-action"
                              rows="4"
                              placeholder="@(isMeal ? "Type your meal here..." : "Describe your workout...")">@Model.UserInput</textarea>

                    <button type="submit" class="btn-primary">
                        Generate
                    </button>
                </form>
                 
                @if (isMeal && Model.GeneratedMealLog != null)
                {
                    <div class="log-result">
                        <h3>Estimated Result</h3>
                        <p><strong>Calories:</strong> @Model.GeneratedMealLog.Calories</p>
                        <ul class="macro-list">
                            <li>Protein: @Model.GeneratedMealLog.Protein</li>
                            <li>Carbs: @Model.GeneratedMealLog.Carbs</li>
                            <li>Fat: @Model.GeneratedMealLog.Fat</li>
                            <li>Fiber: @Model.GeneratedMealLog.Fiber</li>
                        </ul>
                    </div>
                }
                else if (!isMeal && Model.GeneratedWorkoutLog != null)
                {
                    <div class="log-result">
                        <h3>Estimated Result</h3>
                        <p><strong>Calories burned:</strong> @Model.GeneratedWorkoutLog.CaloriesBurned</p>
                    </div>
                }
            </div>
        </section>

        <!-- SIDE -->
        @await Component.InvokeAsync("MenuSide", new { variant = "compact" })

    </div>
</div>

@await Component.InvokeAsync("FloatingBackButton", new {text = "BACK", fallbackUrl = Url.Action("Index", "Home")})

@section Scripts {
    <script>
        (() => {
            const mode = '@Model.Mode';
            const isMeal = '@(isMeal ? "true" : "false")' === "true";
            const tod = isMeal ? '@Model.SelectedTimeOfDay' : 'Workout';
            const key = `InTakeWise.LogDraft.${mode}.${tod}`;

            const form = document.querySelector('.log-form');
            const ta = document.querySelector('textarea[name="userInput"]');
            if (!ta) return;
             
            const draft = localStorage.getItem(key);
            if (draft !== null) ta.value = draft;

            ta.addEventListener('input', () => localStorage.setItem(key, ta.value));
             
            form?.addEventListener('submit', () => localStorage.removeItem(key));
        })();
    </script>
}
