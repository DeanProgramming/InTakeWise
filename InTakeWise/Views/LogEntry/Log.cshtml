@model HomeViewModel

@{
    var isMeal = Model.Mode == LogType.LoggingType.Meal;
    ViewData["Title"] = isMeal ? "Log Meal" : "Log Workout";
}

<div class="auth-page">
    <div class="auth-card menu-card">

        <!-- MAIN -->
        <section class="auth-main">
            <div class="menu-actions">

                <h1 class="auth-title">@ViewData["Title"]</h1>

                <form asp-controller="LogEntry"
                      asp-action="@(isMeal ? "Meal" : "Workout")"
                      asp-route-mode="@(Model.Mode)"
                      method="post"
                      class="log-form">
                       
                    <input type="hidden" name="Mode" value="@Model.Mode" />

                    <textarea name="userInput"
                              class="text-box"
                              rows="4"
                              placeholder="@(isMeal ? "Type your meal here..." : "Describe your workout...")">@Model.UserInput</textarea>

                    <button type="submit" class="btn-primary">
                        Generate
                    </button>

                </form>

                @if (Model.GeneratedLog != null)
                {
                    <div class="log-result">
                        <h3>Generated Result</h3>

                        <p><strong>Calories:</strong> @Model.GeneratedLog.Calories</p>

                        @if (isMeal)
                        {
                            <ul class="macro-list">
                                <li>Protein: @Model.GeneratedLog.Protein</li>
                                <li>Carbs: @Model.GeneratedLog.Carbs</li>
                                <li>Fat: @Model.GeneratedLog.Fat</li>
                                <li>Fiber: @Model.GeneratedLog.Fiber</li>
                            </ul>
                        }
                    </div>
                }

            </div>
        </section>

        <!-- SIDE -->
        <aside class="auth-side menu-side menu-minimised">
            <div class="side-top">
                <h2 class="auth-side-title">@Model.UserName</h2>
                <div class="menu-side-box curved">2000 / 2200</div>
            </div>

            <p class="auth-side-subtitle">
                Protein 120/220 • Carb 200/210 • Fat 24/30 • Fiber 13/40
            </p>
        </aside>

    </div>
</div>
