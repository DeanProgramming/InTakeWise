@model HomeViewModel
@{
    ViewData["Title"] = "Shopping Plan";
}

<div class="auth-page">
    <div class="auth-card menu-card">

        <!-- MAIN -->
        <section class="auth-main">
            <div class="menu-actions">
                <h1 class="auth-title">@ViewData["Title"]</h1>
                 
                <a class="menu-action" href="#">
                    <div class="menu-action-title">Whats in my fridge ?</div>
                    <div class="menu-action-sub">Check whats in your fridge before generating</div>
                </a>

                <form asp-controller="ShoppingSuggestion"
                      asp-action="GetShoppingList"
                      method="post"
                      class="log-form">
                    <button type="submit" class="btn-primary">
                        Generate Shopping List
                    </button>
                </form> 

                <h1 class="auth-title">TEA Plan</h1>

                <div class="log-text-box menu-action"
                     role="textbox"
                     aria-readonly="true"
                     style="white-space: pre-wrap;">

                    @{
                        var plan = Model.ShoppingSuggestionPlan;
                        string output;

                        if (plan?.ShoppingList == null || !plan.ShoppingList.Any())
                        {
                            output = "No shopping suggestions yet.";
                        }
                        else
                        {
                            // SHOPPING LIS
                            output =
                            "Shopping List:\n" +
                            string.Join(
                            "\n",
                            plan.ShoppingList.Select(item =>
                            $"- {item.Name} | {item.Quantity} {item.Unit}" +
                            (item.ExpiryDate.HasValue
                            ? $" (Expires: {item.ExpiryDate.Value:yyyy-MM-dd})"
                            : "")
                            )
                            );

                            // WEEK MEALS SUMMARY 
                            if (plan.WeekMealsSummary != null && plan.WeekMealsSummary.Any())
                            {
                                output +=
                                "\n\nWeekly Meals Summary:\n" +
                                string.Join(
                                "\n",
                                plan.WeekMealsSummary.Select(meal =>
                                $"- {meal.Day}: {meal.Title}\n" +
                                $"  Calories: {meal.Calories} | " +
                                $"P: {meal.ProteinGrams}g | " +
                                $"C: {meal.CarbsGrams}g | " +
                                $"F: {meal.FatGrams}g"
                                )
                                );
                            }
                        }
                    }

                    @output
                </div>
            </div>
        </section>

        <!-- SIDE --> 
        @await Component.InvokeAsync("MenuSide", new { variant = "compact" }) 

    </div>
</div>
