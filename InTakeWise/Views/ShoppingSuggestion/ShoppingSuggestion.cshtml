@model InTakeWise.ViewModels.ShoppingSuggestionViewModel

@{
    ViewData["Title"] = "Shopping Plan";
}

<div class="auth-page">
    <div class="auth-card menu-card">

        <!-- MAIN -->
        <section class="auth-main">
            <div class="menu-actions">
                <h1 class="auth-title">@ViewData["Title"]</h1>

                <a class="menu-action" asp-controller="Pantry" asp-action="Index">
                    <div class="menu-action-title">Whats in my fridge ?</div>
                    <div class="menu-action-sub">Check whats in your fridge before generating</div>
                </a>

                <form asp-controller="ShoppingSuggestion"
                      asp-action="GetShoppingList"
                      method="post"
                      class="log-form">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-primary">
                        Generate Shopping List
                    </button>
                </form>

                <h1 class="auth-title">TEA Plan</h1>

                <div class="log-text-box menu-action"
                     role="textbox"
                     aria-readonly="true"
                     style="white-space: pre-wrap;">

                    @if (Model.ShoppingList == null || !Model.ShoppingList.Any())
                    {
                        <text>No shopping suggestions yet.</text>
                    }
                    else
                    {
                        <text>Shopping List:</text>
                        <ul>
                            @foreach (var item in Model.ShoppingList)
                            {
                                <li>@item.Name | @item.Quantity @item.Unit</li>
                            }
                        </ul>

                        @if (Model.WeekMealsSummary != null && Model.WeekMealsSummary.Any())
                        {
                            <text>Weekly Meals Summary:</text>
                            <ul>
                                @foreach (var meal in Model.WeekMealsSummary)
                                {
                                    <li>
                                        <strong>@meal.Day:</strong> @meal.Title<br />
                                        Calories: @meal.Calories |
                                        P: @meal.ProteinGrams g |
                                        C: @meal.CarbsGrams g |
                                        F: @meal.FatGrams g
                                    </li>
                                }
                            </ul>
                        }
                    }
                </div>
            </div>
        </section>

        <!-- SIDE -->
        @await Component.InvokeAsync("MenuSide", new { variant = "compact" })

    </div>
</div>

@await Component.InvokeAsync("FloatingBackButton", new { controller = "Home", action = "Index", text = "BACK" })
