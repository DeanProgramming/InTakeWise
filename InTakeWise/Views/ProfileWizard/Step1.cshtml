@using InTakeWise.ViewModels
@using InTakeWise.Validation
@model ProfileStep1ViewModel

@{
    ViewData["Title"] = "Profile";
}

<div class="auth-page">
    <div class="auth-card menu-card">

        <section class="auth-main">
            <div class="menu-actions">
                <h1 class="auth-title">Profile</h1>

                @if (TempData["ProfileWizardMessage"] is string message)
                {
                    <div class="profile-wizard-message" role="status">
                        @message
                    </div>
                }

                <form asp-action="Step1"
                      method="post"
                      class="menu-actions-row menu-actions-profile">

                    <div asp-validation-summary="ModelOnly"
                         class="profile-validation"></div>

                    <div class="menu-action menu-action-profile">
                        <div class="menu-action-title">
                            Display name
                        </div>

                        <div class="menu-action-sub">
                            <input class="menu-action menu-text-box-profile"
                                   asp-for="ProfileUserName"
                                   autocomplete="nickname" />

                            <span asp-validation-for="ProfileUserName"></span>
                        </div>
                    </div>

                    <div class="menu-action menu-action-profile">
                        <div class="menu-action-title">Age</div>

                        <div class="menu-action-sub">
                            <input class="menu-action menu-text-box-profile"
                                   asp-for="Age"
                                   type="number"
                                   min="@ValidationLimits.MinimumProfileAge"
                                   max="@ValidationLimits.MaximumProfileAge" />

                            <small>InTakeWise is for adults aged 18+.</small>
                            <span asp-validation-for="Age"></span>
                        </div>
                    </div>

                    <div class="menu-action menu-action-profile">
                        <div class="menu-action-title">
                            Height (cm)
                        </div>

                        <div class="menu-action-sub">
                            <input class="menu-action menu-text-box-profile"
                                   asp-for="HeightInCM"
                                   type="number"
                                   min="@ValidationLimits.MinimumHeightCentimetres"
                                   max="@ValidationLimits.MaximumHeightCentimetres" />

                            <span asp-validation-for="HeightInCM"></span>
                        </div>
                    </div>

                    <div class="menu-action menu-action-profile">
                        <div class="menu-action-title">Gender</div>

                        <div class="menu-action-sub">
                            <select class="menu-action menu-text-box-profile"
                                    asp-for="Gender"
                                    asp-items="Html.GetEnumSelectList<InTakeWise.Models.Genders>()">
                                <option value="">Select an option</option>
                            </select>

                            <span asp-validation-for="Gender"></span>
                        </div>
                    </div>

                    <div class="menu-action menu-action-profile">
                        <div class="menu-action-title">Weight (kg)</div>

                        <div class="menu-action-sub">
                            <input class="menu-action menu-text-box-profile"
                                   asp-for="WeightInKg"
                                   type="number"
                                   min="@ValidationLimits.MinimumWeightKilograms"
                                   max="@ValidationLimits.MaximumWeightKilograms" />

                            <span asp-validation-for="WeightInKg"></span>
                        </div>
                    </div>

                    <button type="submit"
                            class="menu-action menu-action-profile">
                        <div class="menu-action-title">
                            Save &amp; Continue
                        </div>

                        <div class="menu-action-sub">
                            Next: activity and training
                        </div>
                    </button>
                </form>
            </div>
        </section>

        <aside class="auth-side menu-side">
            <div class="side-top">
                <h2 class="auth-side-title">Step 1 of 3</h2>
                <p class="menu-action-sub">
                    Tell us enough to calculate your personalised targets.
                </p>
            </div>
        </aside>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}