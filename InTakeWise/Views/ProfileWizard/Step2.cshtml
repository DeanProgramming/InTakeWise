@using InTakeWise.ViewModels
@using InTakeWise.Models
@model ProfileStep2ViewModel
@{
    ViewData["Title"] = "Fitness Goals";
}

<div class="auth-page">
    <div class="auth-card menu-card">

        <section class="auth-main">
            <div class="menu-actions">
                <h1 class="auth-title">Fitness Goals</h1>
                <form asp-action="Step2" method="post" class="menu-actions-row menu-actions-profile">
                    @Html.AntiForgeryToken()

                    <input type="hidden" asp-for="EveryDayFitnessLevel" id="EveryDayFitnessLevel" />
                    <input type="hidden"
                           asp-for="ChosenGymDays"
                           id="ChosenGymDays"
                           data-initial-gym-days="@((int)Model.ChosenGymDays)" />

                    <div class="menu-action">
                        <div class="menu-action-title">How active are you?</div>
                        <div class="menu-action-sub">Choose one</div>

                        <div class="menu-actions-row">
                            <button type="button"
                                    class="menu-action activity-row"
                                    data-fitness-level="Low"
                                    aria-pressed="@(Model.EveryDayFitnessLevel == FitnessLevel.Low ? "true" : "false")">
                                <div class="menu-action-title">Low</div>
                                <div class="menu-action-sub">Mostly sitting</div>
                            </button>

                            <button type="button"
                                    class="menu-action activity-row"
                                    data-fitness-level="Medium"
                                    aria-pressed="@(Model.EveryDayFitnessLevel == FitnessLevel.Medium ? "true" : "false")">
                                <div class="menu-action-title">Medium</div>
                                <div class="menu-action-sub">Some movement</div>
                            </button>

                            <button type="button"
                                    class="menu-action activity-row"
                                    data-fitness-level="High"
                                    aria-pressed="@(Model.EveryDayFitnessLevel == FitnessLevel.High ? "true" : "false")">
                                <div class="menu-action-title">High</div>
                                <div class="menu-action-sub">Active job / lots of steps</div>
                            </button>
                        </div>

                        <span asp-validation-for="EveryDayFitnessLevel"></span>
                    </div>

                    <div class="menu-action gym-day-selection">
                        <div class="menu-action-title">Which days of the week at gym</div>

                        <div class="menu-actions-row profile-gym-toggle">
                            @foreach (var d in new[] { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday" })
                            {
                                var gymDay = Enum.Parse<GymDays>(d);
                                var isSelected = Model.ChosenGymDays.HasFlag(gymDay);

                                <button type="button"
                                        class="menu-side-box curved curved-profile-Gym-Button"
                                        data-day="@d"
                                        aria-pressed="@(isSelected ? "true" : "false")">
                                    @d.ToUpper()
                                </button>
                            }
                        </div>

                        <span asp-validation-for="ChosenGymDays"></span>
                    </div>

                    <button type="submit" class="menu-action">
                        <div class="menu-action-title">Save & Continue</div>
                        <div class="menu-action-sub">Next: your prediction</div>
                    </button>
                </form>

            </div>
        </section>

        <aside class="auth-side menu-side">
            <div class="side-top">
                <h2 class="auth-side-title">Step 2 of 3</h2>
                <div class="menu-action-sub">Selected: <span id="activityLabel">@Model.EveryDayFitnessLevel</span></div>
            </div>
        </aside>

    </div>
</div>

@section Scripts {
    <script src="~/js/profile-step2.js" asp-append-version="true"></script>
}
