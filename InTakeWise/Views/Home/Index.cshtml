@model InTakeWise.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Menu";
}

<div class="auth-page">
    <div class="auth-card menu-card">

        <!-- MAIN -->
        <section class="auth-main">
            <div class="menu-actions">
                <h1 class="auth-title">Today’s Meals</h1>
                 
                <div class="menu-actions-row">
                    <a class="menu-action menu-meal-row"
                       asp-controller="LogEntry"
                       asp-action="Index"
                       asp-route-mode="Meal"
                       asp-route-meal="@TimeOfDay.Breakfast">
                        <div class="menu-action-title">Breakfast</div>
                        <div class="menu-action-sub">
                            <span class="status-badge @(Model.LoggedBreakfast ? "status-logged" : "status-pending")">
                                @(Model.LoggedBreakfast ? "Logged" : "Log Now")
                            </span>
                        </div>
                    </a>

                    <a class="menu-action menu-meal-row"
                       asp-controller="LogEntry"
                       asp-action="Index"
                       asp-route-mode="Meal" 
                       asp-route-meal="@TimeOfDay.Dinner">
                        <div class="menu-action-title">Dinner</div>
                        <div class="menu-action-sub">
                            <span class="status-badge @(Model.LoggedDinner ? "status-logged" : "status-pending")">
                                @(Model.LoggedDinner? "Logged" : "Log Now")
                            </span>
                        </div>
                    </a>

                    <a class="menu-action menu-meal-row"
                       asp-controller="LogEntry"
                       asp-action="Index"
                       asp-route-mode="Meal"
                       asp-route-meal="@TimeOfDay.Tea">
                        <div class="menu-action-title">Tea</div>
                        <div class="menu-action-sub">
                            <span class="status-badge @(Model.LoggedTea ? "status-logged" : "status-pending")">
                                @(Model.LoggedTea ? "Logged" : "Log Now")
                            </span>
                        </div>
                    </a>
                </div>

                <a class="menu-action"
                   asp-controller="MealSuggestion"
                   asp-action="Index">
                    <div class="menu-action-title">View Recommended Meal</div>
                    <div class="menu-action-sub">Planned for you • ~15 min cook time</div>
                </a> 

                <a class="menu-action" 
                    asp-controller="LogEntry" 
                    asp-action="Index"
                    asp-route-mode="Meal">
                    <div class="menu-action-title">Log Meal </div>
                    <div class="menu-action-sub">You did the hard part — now log it</div>
                </a>

                <a class="menu-action" 
                    asp-controller="LogEntry"
                   asp-action="Index"
                   asp-route-mode="Workout">
                    <div class="menu-action-title">Log Workout</div>
                    <div class="menu-action-sub">You did the hard part — now log it</div>
                </a>
                
                <a class="menu-action"
                   asp-controller="ShoppingSuggestion"
                   asp-action="Index"> 
                    <div class="menu-action-title">Recommend a week’s shopping</div>
                    <div class="menu-action-sub">Tell us what’s in your fridge and we’ll generate the rest</div>
                </a>

                <a class="menu-action"
                   asp-controller="Receipt"
                   asp-action="Index"
                   asp-route-redirect="">
                    <div class="menu-action-title">Receipt to Pantry</div>
                    <div class="menu-action-sub">Take a photo of the Receipt</div>
                </a>

                <a class="menu-action"
                   asp-controller="Pantry"
                   asp-action="Index">
                    <div class="menu-action-title">Whats in my Pantry ? </div>
                    <div class="menu-action-sub">Tell us what’s in your Pantry</div>
                </a>
            </div>
        </section>

        <!-- SIDE -->
        @await Component.InvokeAsync("MenuSide")

    </div>
</div>
