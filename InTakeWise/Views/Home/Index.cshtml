@using InTakeWise.Helper
@model InTakeWise.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Menu";

    var isDemo = User.HasClaim(DbSeeder.DemoClaimType, DbSeeder.DemoClaimValue);
}

<div class="auth-page">
    <div class="auth-card menu-card">

        <section class="auth-main">
            <div class="menu-actions">
                <h1 class="auth-title">Today’s Meals</h1>

                <div class="menu-actions-row">
                    <a class="menu-action menu-meal-row"
                       asp-controller="LogEntry"
                       asp-action="Index"
                       asp-route-mode="Meal"
                       asp-route-meal="@MealType.Breakfast">
                        <div class="menu-action-title">Breakfast</div>
                        <div class="menu-action-sub">
                            <span class="status-badge @(Model.LoggedBreakfast ? "status-logged" : "status-pending")">
                                @(isDemo ? "View sample" : (Model.LoggedBreakfast ? "Logged" : "Log Now"))
                            </span>
                        </div>
                    </a>

                    <a class="menu-action menu-meal-row"
                       asp-controller="LogEntry"
                       asp-action="Index"
                       asp-route-mode="Meal"
                       asp-route-meal="@MealType.Dinner">
                        <div class="menu-action-title">Dinner</div>
                        <div class="menu-action-sub">
                            <span class="status-badge @(Model.LoggedDinner ? "status-logged" : "status-pending")">
                                @(isDemo ? "View sample" : (Model.LoggedBreakfast ? "Logged" : "Log Now"))
                            </span>
                        </div>
                    </a>

                    <a class="menu-action menu-meal-row"
                       asp-controller="LogEntry"
                       asp-action="Index"
                       asp-route-mode="Meal"
                       asp-route-meal="@MealType.Tea">
                        <div class="menu-action-title">Tea</div>
                        <div class="menu-action-sub">
                            <span class="status-badge @(Model.LoggedTea ? "status-logged" : "status-pending")">
                                @(isDemo ? "View sample" : (Model.LoggedBreakfast ? "Logged" : "Log Now"))
                            </span>
                        </div>
                    </a>
                </div>

                <a class="menu-action"
                   asp-controller="MealSuggestion"
                   asp-action="Index">
                    <div class="menu-action-title">View Recommended Meal</div>
                    <div class="menu-action-sub">Planned for you • ~15 min cook time</div>
                </a>
                <a class="menu-action"
                   asp-controller="LogEntry"
                   asp-action="Index"
                   asp-route-mode="Meal">

                    <div class="menu-action-title">
                        @(isDemo ? "View sample meal log" : "Log Meal")
                    </div>

                    <div class="menu-action-sub">
                        @(isDemo ? "Browse today’s pre-generated meal analysis" : "You did the hard part — now log it")
                    </div>
                </a>

                <a class="menu-action"
                   asp-controller="LogEntry"
                   asp-action="Index"
                   asp-route-mode="Workout">

                    <div class="menu-action-title">
                        @(isDemo ? "View sample workout" : "Log Workout")
                    </div>

                    <div class="menu-action-sub">
                        @(isDemo ? "Browse a pre-generated workout analysis" : "You did the hard part — now log it")
                    </div>
                </a>

                <a class="menu-action"
                   asp-controller="ShoppingSuggestion"
                   asp-action="Index">

                    <div class="menu-action-title">
                        @(isDemo ? "View sample plan" : "Recommend a week’s shopping")
                    </div>

                    <div class="menu-action-sub">
                        @(isDemo ? "Explore a pre-generated shopping and meal plan" : "Tell us what’s in your fridge and we’ll generate the rest")
                    </div>
                </a>

                <a class="menu-action"
                   asp-controller="Receipt"
                   asp-action="Index"
                   asp-route-returnUrl="@Url.Action("Index", "Home")">

                    <div class="menu-action-title">
                        @(isDemo ? "Demo Receipt Import" : "Receipt Photo Import")
                    </div>

                    <div class="menu-action-sub">
                        @(isDemo
                                                ? "Try the flow with one built-in fictional receipt"
                                                : "Upload a receipt photo or load a fictional sample")
                    </div>
                </a>

                <a class="menu-action"
                   asp-controller="Pantry"
                   asp-action="Index"
                   asp-route-returnUrl="@Url.Action("Index", "Home")">

                    <div class="menu-action-title">
                        @(isDemo ? "View sample pantry" : "What’s in my Pantry?")
                    </div>

                    <div class="menu-action-sub">
                        @(isDemo ? "Browse fictional seeded pantry items" : "Tell us what’s in your pantry")
                    </div>
                </a>
            </div>
        </section>

        @await Component.InvokeAsync("MenuSide")

    </div>
</div>
