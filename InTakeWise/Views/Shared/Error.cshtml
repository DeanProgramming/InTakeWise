@model ErrorViewModel

@{
    ViewData["Title"] = "Something went wrong";
}

<div class="auth-page">
    <div class="auth-card menu-card">
        <section class="auth-main" aria-labelledby="error-title">
            <div class="menu-actions">

                <h1 id="error-title" class="auth-title">
                    Something went wrong
                </h1>

                <div class="menu-action log-intro-card">
                    <div class="menu-action-title">
                        We couldn’t complete your request.
                    </div>

                    <div class="menu-action-sub">
                        Please try again. If the problem continues, use the
                        request ID below when reporting it.
                    </div>
                </div>

                @if (Model.ShowRequestId)
                {
                    <div class="menu-action log-intro-card">
                        <div class="menu-action-title">
                            Request ID
                        </div>

                        <div class="menu-action-sub">
                            <code class="error-request-id">@Model.RequestId</code>
                        </div>
                    </div>
                }

                <a asp-area=""
                   asp-controller="Home"
                   asp-action="Index"
                   class="menu-action menu-primary-btn">

                    <span class="menu-action-title">
                        Return to InTakeWise
                    </span>

                    <span class="menu-action-sub">
                        Go back to the main page
                    </span>
                </a>

            </div>
        </section>
    </div>
</div>