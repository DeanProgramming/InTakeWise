@page
@model LogoutModel
@{
    ViewData["Title"] = "Log out"; 
    var returnUrl = Url.Page("/", new { area = "" });
}

<div class="auth-page main-menu">
    <section class="auth-card menu-card">
        <aside class="auth-side menu-side small-menu">
            <div class="side-top">
                <div class="side-top-link">
                    <h1 class="auth-side-title">Account</h1>
                </div>
            </div>
        </aside>

        <main class="auth-main">
            <h2 class="auth-title">@ViewData["Title"]</h2>

            <div class="menu-actions">
                <form asp-area="Identity"
                        asp-page="/Account/Logout"
                        asp-route-returnUrl="@returnUrl"
                        method="post"
                        class="menu-logout">
                    <button type="submit" class="menu-action menu-primary-btn menu-logout-btn">
                        <span class="menu-action-title">Log out</span>
                        <span class="menu-action-sub">Confirm and sign out now</span>
                    </button>
                </form>

                <div class="menu-links">
                    <a class="menu-link" href="@returnUrl">Cancel and go back</a>
                </div>
            </div>
        </main>
    </section>
</div>